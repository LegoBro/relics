## Displays arena
execute unless score @s set.arena matches 0 run item replace block ~1 ~ ~ container.0 with structure_block[item_model=moss_block,custom_data={Arena:0},item_name={"translate":"arena.moss","color":"green","italic":false},lore=["",{text:"RedstoneBattery",color:gray,italic:false}]]
